# Template de variáveis de ambiente.
# Copie para `.env` (que é ignorado pelo git) antes de subir a stack:
#   cp .env.env .env

# ---------------------------------------------------------------- Airflow
AIRFLOW_UID=50000
AIRFLOW_DB=airflow_db
FERNET_KEY=46ExTH2386fB75914M45037ETh115a3k=
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---------------------------------------------------------------- Postgres
DB_USER=postgres
DB_PASSWORD=postgrespassword
POSTGRES_PASSWORD=postgrespassword
DB_NAME=pipeline_db
DB_HOST=postgres-db
DB_PORT=5432

# ---------------------------------------------------------------- DockerOperator
# Caminho DESTE repositório como o daemon do Docker o enxerga.
#
# O DockerOperator é apenas um cliente da API do daemon: os `source` dos mounts
# são resolvidos pelo daemon, não dentro do container do Airflow. No Docker
# Desktop (Windows/macOS) o daemon roda numa VM, onde o disco C: aparece em
# /run/desktop/mnt/host/c/. Um caminho `C:\...` aqui não falha — cria um
# diretório vazio em silêncio, e as tasks "passam" sem processar nada.
#
# Windows (Docker Desktop):  /run/desktop/mnt/host/c/Users/{SEU_USUARIO_WINDOWS}/IA/Workspace/IngestionPipeline_04
# Linux (Docker Engine):     /caminho/absoluto/do/repo
HOST_PROJECT_DIR=/run/desktop/mnt/host/c/Users/{SEU_USUARIO_WINDOWS}/IA/Workspace/IngestionPipeline_04

# ---------------------------------------------------------------- OpenMetadata
OM_SERVER_URL=http://openmetadata-server:8585/api
# Token do bot de ingestão. Preencher DEPOIS do primeiro boot:
# http://localhost:8585 -> Settings -> Bots -> ingestion-bot -> copiar o token.
OM_JWT_TOKEN=
# Fernet do secrets manager do OpenMetadata (valor de quickstart, só para dev).
OM_FERNET_KEY=jJ/9sz0g0OHxsfxOoSfdFdmk3ysNmPRnH3TUAbz3IHA=
